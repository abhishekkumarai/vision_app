# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Provider: 'ollama', 'gemini', or 'mock'
LLM_PROVIDER=ollama

# Ollama Settings (Local Gemma 2 / Multimodal models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Google Gemini / GenAI Settings (Optional Cloud Multi-Modal)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
